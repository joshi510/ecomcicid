PORT=5000
NODE_ENV=development

# PostgreSQL — replace user, password, and database name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecom_db?schema=public

# JWT — use long, distinct random strings in real environments
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Vite default origin
CLIENT_URL=http://localhost:5173

# Cookie SameSite. Omit for defaults (lax in development, none in production).
# Use none when the storefront and API are on different sites (Vercel + Render).
# COOKIE_SAMESITE=lax

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Checkout totals
TAX_RATE=0.08
SHIPPING_FLAT_RATE=9.99
FREE_SHIPPING_THRESHOLD=75

# Stripe — use Dashboard test keys and the webhook signing secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional — product list cache. When omitted, an in-memory TTL cache is used.
# REDIS_URL=redis://127.0.0.1:6379
