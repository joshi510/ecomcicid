NODE_ENV=production
PORT=5000

# Managed Postgres (Render / Railway / Fly / Neon / RDS)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ecom_db?schema=public&sslmode=require

# Optional product-list cache. Omit to use in-memory TTL.
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Long, distinct random strings (32+ chars). Never reuse across environments.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public storefront origin — must match the Vercel/Netlify URL (no trailing slash)
CLIENT_URL=https://shop.example.com

# Split hosting (Vercel + Render) needs SameSite=None so cookies travel cross-site.
# Same registrable domain (shop.example.com + api.example.com) can use strict.
COOKIE_SAMESITE=none

LOG_LEVEL=info

TAX_RATE=0.08
SHIPPING_FLAT_RATE=9.99
FREE_SHIPPING_THRESHOLD=75

# Live Stripe keys + webhook signing secret for https://API_HOST/api/payments/webhook
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
